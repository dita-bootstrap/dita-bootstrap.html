    <section id="intervals">
      <title>Carousel interval</title>
      <p>Add <xmlatt>interval="2000"</xmlatt> to the <xmlelement
        >carousel</xmlelement> to change the amount of time to delay
        between automatically cycling to the next item.</p>
    </section>
    <example deliveryTarget="html">
      <ol outputclass="carousel">
        <li>
          <image scope="external" href="https://picsum.photos/1200/600?a"/>
        </li>
        <li>
          <image scope="external" href="https://picsum.photos/1200/600?b"/>
        </li>
      </ol>
    </example>
    <codeblock>&lt;carousel interval="2000"&gt;
  ...
&lt;/carousel&gt;</codeblock>

    <section id="item-intervals">
      <title>Individual carousel item interval</title>
      <p>Add <xmlatt>interval="1000"</xmlatt> to a <xmlelement
        >carousel-item</xmlelement> to change the amount of time to delay
        between automatically cycling to the next item.</p>
    </section>
    <example deliveryTarget="html">
