<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="spacing">
  <title>Spacing</title>
  <shortdesc>Use margin and padding utilities to quickly control the layout of elements. The <xmlatt
    >margin</xmlatt> and <xmlatt
    >padding</xmlatt> attributes enable standard Bootstrap spacing across a range of DITA components.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Spacing</indexterm>
        <indexterm>Margin</indexterm>
        <indexterm>Padding</indexterm>
        <indexterm>CSS
          <indexterm><xmlatt>outputclass</xmlatt></indexterm>
        </indexterm>
        <indexterm><xmlatt>margin</xmlatt></indexterm>
        <indexterm><xmlatt>padding</xmlatt></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <body outputclass="language-markup">
    <section id="margin">
      <title>Margin</title>
      <p>The <xmlatt
        >margin</xmlatt> attribute controls the distance between elements, supporting values from 0 to 5 and <codeph
        >auto</codeph>.</p>
    </section>

    <example>
      <div outputclass="theme-primary theme-contrast m-0 p-2">Margin 0</div>
      <div outputclass="theme-secondary theme-contrast m-1 p-2">Margin 1</div>
      <div outputclass="theme-success theme-contrast m-2 p-2">Margin 2</div>
      <div outputclass="theme-danger theme-contrast m-3 p-2">Margin 3</div>
      <div outputclass="theme-warning theme-contrast m-4 p-2">Margin 4</div>
      <div outputclass="theme-info theme-contrast m-5 p-2">Margin 5</div>
      <div outputclass="theme-accent theme-contrast m-auto p-2 w-50">Margin Auto</div>
    </example>

    <bodydiv outputclass="nav-pills mt-3">
      <section>
        <title><xmlatt>outputclass</xmlatt></title>
        <codeblock>&lt;div outputclass="theme-primary theme-contrast m-0 p-2"&gt;Margin 0&lt;/div&gt;
&lt;div outputclass="theme-secondary theme-contrast m-1 p-2"&gt;Margin 1&lt;/div&gt;
&lt;div outputclass="theme-success theme-contrast m-2 p-2"&gt;Margin 2&lt;/div&gt;
&lt;div outputclass="theme-danger theme-contrast m-3 p-2"&gt;Margin 3&lt;/div&gt;
&lt;div outputclass="theme-warning theme-contrast m-4 p-2"&gt;Margin 4&lt;/div&gt;
&lt;div outputclass="theme-info theme-contrast m-5 p-2"&gt;Margin 5&lt;/div&gt;
&lt;div outputclass="theme-accent theme-contrast m-auto p-2 w-50"&gt;Margin Auto&lt;/div&gt;</codeblock>
      </section>
      <section>
        <title>Specialization</title>
        <codeblock>&lt;div theme="primary-contrast" margin="0" padding="2"&gt;Margin 0&lt;/div&gt;
&lt;div theme="secondary-contrast" margin="1" padding="2"&gt;Margin 1&lt;/div&gt;
&lt;div theme="success-contrast" margin="2" padding="2"&gt;Margin 2&lt;/div&gt;
&lt;div theme="danger-contrast" margin="3" padding="2"&gt;Margin 3&lt;/div&gt;
&lt;div theme="warning-contrast" margin="4" padding="2"&gt;Margin 4&lt;/div&gt;
&lt;div theme="info-contrast" margin="5" padding="2"&gt;Margin 5&lt;/div&gt;
&lt;div theme="accent-contrast" margin="auto" padding="2" width="50"&gt;Margin Auto&lt;/div&gt;</codeblock>
      </section>
    </bodydiv>

    <section id="padding">
      <title>Padding</title>
      <p>The <xmlatt
        >padding</xmlatt> attribute controls the internal spacing of an element, supporting values from 0 to 5.</p>
    </section>

    <example>
      <div outputclass="theme-primary theme-contrast p-0">Padding 0</div>
      <div outputclass="theme-secondary theme-contrast p-1 m-1"><div
          outputclass="theme-secondary theme-subtle w-100"
        >Padding 1</div></div>
      <div outputclass="theme-success theme-contrast p-2 m-1"><div
          outputclass="theme-success theme-subtle w-100"
        >Padding 2</div></div>
      <div outputclass="theme-danger theme-contrast p-3 m-1"><div
          outputclass="theme-danger theme-subtle w-100"
        >Padding 3</div></div>
      <div outputclass="theme-warning theme-contrast p-4 m-1"><div
          outputclass="theme-warning theme-subtle w-100"
        >Padding 4</div></div>
      <div outputclass="theme-info theme-contrast p-5 m-1"><div
          outputclass="theme-info theme-subtle w-100"
        >Padding 5</div></div>
    </example>

    <bodydiv outputclass="nav-pills mt-3">
      <section>
        <title><xmlatt>outputclass</xmlatt></title>
        <codeblock>&lt;div outputclass="theme-primary theme-contrast p-0"&gt;Padding 0&lt;/div&gt;
&lt;div outputclass="theme-secondary theme-contrast p-1 m-1"&gt;Padding 1&lt;/div&gt;
&lt;div outputclass="theme-success theme-contrast p-2 m-1"&gt;Padding 2&lt;/div&gt;
&lt;div outputclass="theme-danger theme-contrast p-3 m-1"&gt;Padding 3&lt;/div&gt;
&lt;div outputclass="theme-warning theme-contrast p-4 m-1"&gt;Padding 4&lt;/div&gt;
&lt;div outputclass="theme-info theme-contrast p-5 m-1"&gt;Padding 5&lt;/div&gt;</codeblock>
      </section>
      <section>
        <title>Specialization</title>
        <codeblock>&lt;div theme="primary-contrast" padding="0"&gt;Padding 0&lt;/div&gt;
&lt;div theme="secondary-contrast" padding="1" margin="1"&gt;Padding 1&lt;/div&gt;
&lt;div theme="success-contrast" padding="2" margin="1"&gt;Padding 2&lt;/div&gt;
&lt;div theme="danger-contrast" padding="3" margin="1"&gt;Padding 3&lt;/div&gt;
&lt;div theme="warning-contrast" padding="4" margin="1"&gt;Padding 4&lt;/div&gt;
&lt;div theme="info-contrast" padding="5" margin="1"&gt;Padding 5&lt;/div&gt;</codeblock>
      </section>
    </bodydiv>

    <section id="directional-spacing">
      <title>Directional Spacing</title>
      <p>The <xmlatt>margin</xmlatt> and <xmlatt
        >padding</xmlatt> attributes also support directional spacing using a prefix:</p>
      <ul>
        <li><codeph>t</codeph> - Top</li>
        <li><codeph>b</codeph> - Bottom</li>
        <li><codeph>s</codeph> - Start (Left in LTR)</li>
        <li><codeph>e</codeph> - End (Right in LTR)</li>
        <li><codeph>x</codeph> - Horizontal (Start and End)</li>
        <li><codeph>y</codeph> - Vertical (Top and Bottom)</li>
      </ul>
      <p>Multiple values can be specified as a space-separated list.</p>
    </section>

    <example>
      <div outputclass="mt-5 mb-0 bg-primary fg-contrast-primary">Margin Top 5, Bottom 0</div>
      <div outputclass="mx-3 bg-secondary fg-contrast-secondary">Margin Horizontal 3</div>
      <div outputclass="py-5 bg-success"><div
          outputclass="bg-subtle-success fg-contrast-subtle-success  w-100"
        >Padding Vertical 5</div></div>
      <div outputclass="ps-3 pe-1 bg-danger"><div
          outputclass="bg-subtle-danger fg-contrast-subtle-danger w-100"
        >Padding Start 3, End 1</div></div>
    </example>

    <bodydiv outputclass="nav-pills mt-3">
      <section>
        <title><xmlatt>outputclass</xmlatt></title>
        <codeblock>&lt;div outputclass="bg-primary mt-5 mb-0"&gt;Margin Top 5, Bottom 0&lt;/div&gt;
&lt;div outputclass="bg-secondary mx-3"&gt;Margin Horizontal 3&lt;/div&gt;
&lt;div outputclass="bg-success py-5"&gt;Padding Vertical 5&lt;/div&gt;
&lt;div outputclass="bg-danger ps-3 pe-1"&gt;Padding Start 3, End 1&lt;/div&gt;</codeblock>
      </section>
      <section>
        <title>Specialization</title>
        <codeblock>&lt;div theme="primary-contrast" margin="t5 b0"&gt;Margin Top 5, Bottom 0&lt;/div&gt;
&lt;div theme="secondary-contrast" margin="x3"&gt;Margin Horizontal 3&lt;/div&gt;
&lt;div theme="success-contrast" padding="y5"&gt;Padding Vertical 5&lt;/div&gt;
&lt;div theme="danger-contrast" padding="s3 e1"&gt;Padding Start 3, End 1&lt;/div&gt;</codeblock>
      </section>
    </bodydiv>
  </body>
</topic>
